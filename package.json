{
  "name": "rendered-review",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @rendered-review/web dev",
    "build": "pnpm -r --if-present build",
    "test": "vitest run",
    "bench": "vitest bench --run --project \"web (bench)\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.6",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
